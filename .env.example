# Copy to .env for local development: cp .env.example .env
# Every value below is a LOCAL DEMO VALUE. Never reuse these anywhere real.

# Django
DJANGO_SECRET_KEY=local-demo-only-insecure-secret-key-change-me
# DEBUG defaults to off in code; it is switched on here for local development only.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# PostgreSQL (internal to the Compose network, not published to the host)
POSTGRES_DB=room_booking
POSTGRES_USER=room_booking
POSTGRES_PASSWORD=local-demo-db-password

# Password shared by the demo users user1, user2 and user3 (local demo value)
DEMO_USER_PASSWORD=demo-pass-2026
